# Opengist on Railway — environment variables
#
# The one-click deploy form has a single generated field
# (OG_SECRET_KEY). Everything else is baked into the wrapper image or
# derived at boot. Copy this file to .env only for local reference —
# these values are documentation, not a deploy mechanism.

# Random secret for session signing and MFA data encryption.
# Generated on the deploy form as ${{secret(32)}} — keep it stable,
# changing it invalidates all user sessions.
OG_SECRET_KEY=your-generated-secret-key

# HTTP port Opengist listens on. The wrapper entrypoint exports
# OG_HTTP_PORT=$PORT on every boot; do not set it yourself.
OG_HTTP_PORT=6157

# Data home: SQLite database, gist Git repos, Bleve search index,
# logs. Baked to /opengist (the Railway volume mount) in the Dockerfile.
OG_OPENGIST_HOME=/opengist

# Public URL. Derived at boot from the live RAILWAY_PUBLIC_DOMAIN by
# the entrypoint; only set it manually for a custom domain.
OG_EXTERNAL_URL=https://your-domain.up.railway.app

# Built-in SSH server for git over SSH. Disabled in the wrapper:
# Railway's public edge is HTTP-only, so port 2222 is not publicly
# reachable and the SSH clone URLs would not work. Git over HTTP
# works through the proxy.
OG_SSH_GIT_ENABLED=false

# Optional upstream settings (defaults shown; see
# https://opengist.io/docs/configuration/cheat-sheet.html for the full
# list). All are read from the environment and override /config.yml.
# OG_LOG_LEVEL=warn
# OG_INDEX=bleve
# OG_CUSTOM_NAME=
# OG_GITHUB_CLIENT_KEY= / OG_GITHUB_SECRET= (GitHub OAuth login)
# OG_GITLAB_CLIENT_KEY= / OG_GITLAB_SECRET= (GitLab OAuth login)
# OG_GITEA_CLIENT_KEY= / OG_GITEA_SECRET= (Gitea OAuth login)
# OG_OIDC_PROVIDER_NAME= / OG_OIDC_CLIENT_KEY= / OG_OIDC_SECRET= / OG_OIDC_DISCOVERY_URL= (OIDC login)
# OG_LDAP_URL= (LDAP login; unset disables LDAP)
